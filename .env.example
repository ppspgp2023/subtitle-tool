# ===== 视频字幕生成服务 · 环境变量示例 =====
# 复制本文件为 .env 后按需修改。.env 已在 .gitignore 中，不会被提交。

# ---------- 网页登录（单一共享账号）----------
# 登录用户名
AUTH_USER=admin
# 登录密码（请改成强密码；公网访问务必配合 HTTPS）
AUTH_PASS=change-me-please
# 签发登录 Cookie 的密钥，随机长字符串即可（改动后所有人需重新登录）
SESSION_SECRET=please-generate-a-long-random-string

# ---------- 服务与存储 ----------
# 监听端口
PORT=3000
# 数据目录（上传视频、生成字幕、临时文件都在这里）。留空则用项目下的 data/
DATA_DIR=
# 文件保留天数，超过后自动删除（上传视频与字幕）
RETENTION_DAYS=7

# ---------- OpenAI / 兼容接口（翻译用）----------
# API Key（必填）
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxx
# 接口地址，OpenAI 官方为 https://api.openai.com/v1
OPENAI_BASE_URL=https://api.openai.com/v1
# 翻译模型
TRANSLATE_MODEL=gpt-4o-mini

# ---------- Whisper 听写（可与翻译分开，比如用 Groq）----------
# 听写接口地址；留空则复用 OPENAI_BASE_URL
WHISPER_BASE_URL=
# 听写 API Key；留空则复用 OPENAI_API_KEY
WHISPER_API_KEY=
# 听写模型（OpenAI 用 whisper-1；Groq 用 whisper-large-v3 等）
WHISPER_MODEL=whisper-1

# ---------- 字幕默认选项（网页上可逐次覆盖）----------
# bilingual = 双语（原文+中文）；chinese = 纯中文
SUBTITLE=bilingual
# 视频原语言代码，不确定填 auto 自动识别（如 ja/en/ko/zh）
SOURCE_LANG=auto
# 每段切片时长（秒），越大越省请求数但单次越慢，建议 300~900
CHUNK_SECONDS=600

# ---------- 代理（境外 VPS 直连时留空）----------
# 仅听写请求走代理。格式 http://127.0.0.1:7890，留空表示直连
PROXY_URL=

# ---------- 磁力导入（可选，TorBox）----------
# 配了 TORBOX_API_KEY 网页上才会出现“磁力导入”入口；留空则只有上传功能。
# 磁力链交给 TorBox 云端下载，本服务只拉回成品视频，拉完自动删 TorBox 那份。
MAGNET_PROVIDER=torbox
# TorBox 的 API Key（登录 torbox.app → Settings/API 获取）
TORBOX_API_KEY=
# 总开关：默认 true（配了 Key 即启用）；填 false 可强制关闭
MAGNET_ENABLED=true
# 云端下载并发上限：免费档只有 1 个下载槽，填 1；Pro/付费档可填 3 等（多个磁力同时云端下载）
MAGNET_MAX_CONCURRENT=1
