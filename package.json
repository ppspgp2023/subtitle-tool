    "build": "node build.js",
    "check": "node scripts/check-api.js"
  },
  "dependencies": {
    "dotenv": "^16.6.1",
    "express": "^4.22.2",
    "ffmpeg-static": "^5.2.0"
  },
  "devDependencies": {
    "postject": "^1.0.0-alpha.6"
  }
}
